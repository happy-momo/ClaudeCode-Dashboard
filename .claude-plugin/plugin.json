{
  "name": "claude-dashboard",
  "version": "1.0.0",
  "description": "Claude Code management dashboard - sessions, configs, token stats, and conversations",
  "author": {
    "name": "Claude Dashboard Team"
  },
  "repository": "https://github.com/happy-momo/ClaudeCode-Dashboard",
  "license": "MIT",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh ${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py",
            "timeout": 30000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh ${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt.py",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh ${CLAUDE_PLUGIN_ROOT}/hooks/post_tool.py",
            "timeout": 10000
          }
        ]
      }
    ],
    "MessageStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/run-python.sh ${CLAUDE_PLUGIN_ROOT}/hooks/message_stop.py",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}